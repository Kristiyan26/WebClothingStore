@model ProjectMarto.ViewModels.Cart.IndexVM;
<h2>Your Shopping Cart</h2>
<table>
    <thead>
        <tr>
            <th>Product</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Product item in Model.Products)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price.ToString("F2")</td>
                <td>
                    <a asp-action="RemoveFromCart" asp-controller="Cart" asp-route-id="@item.ProductId">Remove</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" asp-controller="Home">Continue Shopping</a>
<a asp-action="Buy" asp-controller="Cart">Buy</a>