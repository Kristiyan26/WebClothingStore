@model ProjectMarto.ViewModels.Preview.IndexVM;


<div>
    <h1>@Model.Product.Name</h1>
    <p>@Model.Product.Description</p>
    <h3>Price: @Model.Product.Price</h3>

    <h4>Reviews:</h4>
    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        <ul>
            @foreach (var review in Model.Reviews)
            {
                <li>@review.Comment</li>
            }
        </ul>
    }
    else
    {
        <p>No reviews available.</p>
    }

    <a asp-action="Buy" asp-controller="Preview" asp-route-id="Model.Product.ProductId" class="btn btn-success">Buy</a>
    <a asp-action="Index" asp-controller="Home" class="btn btn-danger" >Cancel</a>
</div>
